<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ScreenshotManager</AssemblyName>
    <RootNamespace>ScreenshotManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>ScreenshotManager.Program</StartupObject>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS0169;CS0649;MSB3277;WFAC010</NoWarn>
    <Version>1.0.0</Version>
    <Product>截图管家 ScreenshotManager</Product>
    <Company>ScreenshotManager</Company>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!--
    UseWindowsForms pulls System.Drawing / System.Windows.Forms into the implicit
    usings, which makes Point/Color/Brush/Pen/Brushes/Clipboard/DataFormats...
    ambiguous in every WPF file. Drop them; WinForms code opts in explicitly.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>